# Local development only. Run python scripts/setup_local.py to generate secrets.
APP_ENV=development
APP_DEMO_MODE=false
POSTGRES_MCP_ENABLED=false
# Use a dedicated PostgreSQL login with SELECT privileges only. Never commit this URL.
POSTGRES_MCP_DATABASE_URL=
APP_NAME=BeverageOps AI
APP_TIMEZONE=Asia/Ho_Chi_Minh
STORE_ID=
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_DB=beverageops
POSTGRES_USER=beverageops
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# No external provider is enabled until credentials and data permission exist.
LLM_ENABLED=false
OCR_MODEL=
LLM_PROVIDER=
# OpenRouter: LLM_PROVIDER=openrouter, LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenAI: LLM_PROVIDER=openai, LLM_BASE_URL=https://api.openai.com/v1
# Use a model ID with tool calling support. Keys belong only in your local .env.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1400
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_CALLS=10
AGENT_MAX_HISTORY_MESSAGES=40
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=120
ALLOW_EXTERNAL_DATA_TRANSFER=false
SHADOW_MODE=true
REQUIRE_MANAGER_APPROVAL=true
AUTO_PURCHASE_ENABLED=false

# Weather uses only coordinates/dates; no sales data is sent to Open-Meteo.
WEATHER_ENABLED=false
WEATHER_LATITUDE=21.0285
WEATHER_LONGITUDE=105.8542
WEATHER_LOCATION_LABEL="Hà Nội · điểm tham chiếu thành phố"
STORE_OPENING_HOUR=8
STORE_CLOSING_HOUR=22

STORAGE_BACKEND=local
RAW_DATA_DIR=data/raw_private
STAGING_DATA_DIR=data/staging_private
PROCESSED_DATA_DIR=data/processed_private
QUALITY_REPORT_DIR=data/quality_reports
SNAPSHOT_DIR=data/snapshots_private
MAX_UPLOAD_SIZE_MB=20
FORECAST_MIN_HISTORY_DAYS=14
FORECAST_HORIZON_DAYS=1
FORECAST_SEASONAL_PERIOD=7
FORECAST_MOVING_AVERAGE_WINDOW=7
RANDOM_SEED=42
# Scheduler disabled until a single managed worker is implemented.
SCHEDULER_ENABLED=false

